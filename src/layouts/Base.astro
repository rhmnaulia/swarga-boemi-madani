---
import { getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ActionDock from "../components/ActionDock.astro";
import Tracking from "../components/Tracking.astro";
import { PROJECT_NAME } from "../content/site";
import { getPengaturan } from "../lib/cms";
import { businessLd, ldJson, OG_IMAGE, siteOrigin } from "../lib/seo";
import type { WaContext } from "../lib/wa";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Message context for the WhatsApp action dock. */
	wa?: WaContext;
	/** Page has a `[data-hero]` with its own CTAs; the dock appears after it. */
	dockAfterHero?: boolean;
	/** Survey link in the dock; `null` swaps it for a phone call (contact page). */
	surveyHref?: string | null;
	/** Hide the dock on pages that are themselves the next step (thank-you). */
	dock?: boolean;
	/** Structured data for this page (schema.org objects). */
	jsonLd?: unknown[];
	/** Add the business (HomeAndConstructionBusiness) structured data. */
	business?: boolean;
}

const {
	title,
	description,
	image,
	canonical,
	content,
	wa,
	dockAfterHero,
	surveyHref,
	dock = true,
	jsonLd = [],
	business = false,
} = Astro.props;
const [settingsResult, pengaturan] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getPengaturan(Astro.cache),
]);
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);

const settings = settingsResult.data;
const siteTitle = settings?.title ?? PROJECT_NAME;
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const pageDescription = description ?? settings?.tagline ?? null;
// Absolute URLs on the public origin; the query string never makes a separate page.
const origin = siteOrigin(Astro.url);
const pageCanonical = canonical ?? `${origin}${Astro.url.pathname}`;
const pageImage = new URL(image ?? OG_IMAGE, origin).href;
const structured = business ? [businessLd(origin, pengaturan), ...jsonLd] : jsonLd;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title,
	description: pageDescription,
	canonical: pageCanonical,
	image: pageImage,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#faf7f2" />
		<title>{fullTitle}</title>
		<script is:inline>
			// Fades `.reveal` blocks in as they scroll into view. Only blocks below the fold are ever
			// hidden: what is on screen at load shows at once, so it does not appear a second time
			// after the page transition. Inline so a failed script download never hides content.
			document.documentElement.classList.add("js");
			document.addEventListener("DOMContentLoaded", function () {
				if (!("IntersectionObserver" in window)) return;
				var io = new IntersectionObserver(
					function (entries) {
						entries.forEach(function (e) {
							if (e.isIntersecting) {
								e.target.classList.remove("reveal-pending");
								io.unobserve(e.target);
							}
						});
					},
					{ rootMargin: "0px 0px -40px 0px" },
				);
				document.querySelectorAll(".reveal").forEach(function (el) {
					if (el.getBoundingClientRect().top < window.innerHeight) return;
					el.classList.add("reveal-pending");
					io.observe(el);
				});
			});
		</script>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		{structured.map((data) => (
			<script type="application/ld+json" set:html={ldJson(data)} />
		))}
		<Tracking />
		<slot name="head" />
		<EmDashHead page={pageCtx} />
	</head>
	<body class="flex min-h-dvh flex-col">
		<EmDashBodyStart page={pageCtx} />
		<a
			href="#konten"
			class="bg-brand-green sr-only z-50 rounded-md px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
		>
			Langsung ke konten
		</a>
		{pengaturan?.banner_promo && (
			<p class="bg-brand-green-dark px-4 py-2 text-center text-sm font-medium text-white">
				{pengaturan.banner_promo}
			</p>
		)}
		<Header logo={settings?.logo} />
		<main id="konten" class="flex-1">
			<slot />
		</main>
		<Footer pengaturan={pengaturan} />
		{dock && (
			<>
				{/* Room for the mobile dock under the footer, in the footer colour. */}
				<div
					class="bg-brand-green-dark h-[calc(4.5rem+env(safe-area-inset-bottom))] lg:hidden"
					aria-hidden="true"
				/>
				<ActionDock ctx={wa} afterHero={dockAfterHero} surveyHref={surveyHref} />
			</>
		)}
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
