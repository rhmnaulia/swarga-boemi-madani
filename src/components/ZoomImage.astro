---
import { Image } from "emdash/ui";
import type { FotoKey } from "../content/foto";
import Icon from "./Icon.astro";
import Media from "./Media.astro";
import Photo from "./Photo.astro";

type ImageValue = { id: string; src?: string; alt?: string; width?: number; height?: number };

interface Props {
	image?: ImageValue | null;
	fallback?: FotoKey;
	alt: string;
	ratio?: "4/3" | "3/2" | "16/9" | "1/1" | "3/4" | "4/5";
	sizes?: string;
	fit?: "cover" | "contain";
	placeholder?: string;
	natural?: boolean;
	hint?: boolean | "hover";
	class?: string;
}

const {
	image,
	fallback,
	alt,
	natural = false,
	hint = true,
	class: className,
	...media
} = Astro.props;
const zoomable = Boolean(image || fallback);
---

{zoomable ? (
	<div data-zoom class={className}>
		<button
			type="button"
			class="pressable-soft group relative block w-full cursor-zoom-in"
			aria-label={`Perbesar ${alt}`}
			data-zoom-open
		>
			{natural && !image && fallback ? (
				<Photo
					foto={fallback}
					alt={alt}
					sizes={media.sizes}
					class="border-line block h-auto w-full rounded-(--radius-card) border bg-white"
				/>
			) : (
				<Media
					image={image}
					fallback={fallback}
					alt={alt}
					class="border-line border bg-white"
					{...media}
				/>
			)}
			{hint && (
				<span
					class:list={[
						"pointer-events-none absolute right-3 bottom-3 inline-flex items-center gap-1.5 rounded-full bg-black/65 px-3 py-1.5 text-xs font-semibold text-white",
						hint === "hover" &&
							"opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100",
					]}
				>
					<Icon name="zoom-in" class="size-4" />
					Perbesar
				</span>
			)}
		</button>

		<dialog class="lightbox" aria-label={alt} data-zoom-dialog>
			<div class="zoom-stage" data-zoom-stage>
				{image ? (
					<Image image={image} alt={image.alt || alt} sizes="100vw" class="zoom-img" />
				) : (
					fallback && <Photo foto={fallback} alt={alt} sizes="100vw" class="zoom-img" />
				)}
			</div>
			<div class="absolute top-3 right-3 z-10 flex gap-2">
				<button
					type="button"
					class="grid size-11 place-items-center rounded-full bg-black/60 text-white"
					aria-label="Perbesar"
					aria-pressed="false"
					data-zoom-toggle
				>
					<span data-zoom-icon="in">
						<Icon name="zoom-in" class="size-6" />
					</span>
					<span class="hidden" data-zoom-icon="out">
						<Icon name="zoom-out" class="size-6" />
					</span>
				</button>
				<button
					type="button"
					class="grid size-11 place-items-center rounded-full bg-black/60 text-white"
					aria-label="Tutup"
					data-zoom-close
				>
					<Icon name="close" class="size-6" />
				</button>
			</div>
			<p class="pointer-events-none absolute inset-x-0 bottom-4 text-center text-sm text-white/80">
				<span data-zoom-hint="in">Ketuk gambar untuk memperbesar</span>
				<span class="hidden" data-zoom-hint="out">
					Geser untuk melihat bagian lain, ketuk untuk kembali
				</span>
			</p>
		</dialog>
	</div>
) : (
	<Media alt={alt} class:list={["border-line border bg-white", className]} {...media} />
)}

<style>
	.zoom-stage {
		display: flex;
		width: 100%;
		height: 100%;
		overflow: auto;
		overscroll-behavior: contain;
		cursor: zoom-in;
	}
	.zoom-stage[data-zoomed] {
		cursor: grab;
	}
	.zoom-stage[data-panning] {
		cursor: grabbing;
	}
	.zoom-stage :global(.zoom-img) {
		flex: none;
		margin: auto;
		max-width: none;
		max-height: none;
		background: white;
		user-select: none;
		-webkit-user-drag: none;
	}
</style>

<script>
	const ZOOM = 2.5;
	const EASE = "cubic-bezier(0.23, 1, 0.32, 1)";
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	document.querySelectorAll<HTMLElement>("[data-zoom]").forEach((root) => {
		const dialog = root.querySelector<HTMLDialogElement>("[data-zoom-dialog]");
		const stage = root.querySelector<HTMLElement>("[data-zoom-stage]");
		const img = stage?.querySelector<HTMLImageElement>("img");
		const toggle = root.querySelector<HTMLButtonElement>("[data-zoom-toggle]");
		if (!dialog || !stage || !img || !toggle) return;
		let zoomed = false;

		const fitWidth = () => {
			const ratio = (img.naturalWidth || img.width) / (img.naturalHeight || img.height);
			return Math.min(stage.clientWidth, stage.clientHeight * ratio);
		};

		const setWidth = (w: number) => {
			img.style.width = `${w}px`;
			img.style.height = "auto";
		};

		const render = () => {
			stage.toggleAttribute("data-zoomed", zoomed);
			toggle.setAttribute("aria-pressed", String(zoomed));
			toggle.setAttribute("aria-label", zoomed ? "Perkecil" : "Perbesar");
			root.querySelectorAll<HTMLElement>("[data-zoom-icon]").forEach((el) => {
				el.classList.toggle("hidden", (el.dataset.zoomIcon === "out") !== zoomed);
			});
			root.querySelectorAll<HTMLElement>("[data-zoom-hint]").forEach((el) => {
				el.classList.toggle("hidden", (el.dataset.zoomHint === "out") !== zoomed);
			});
		};

		const zoomAt = (x: number, y: number) => {
			const before = img.getBoundingClientRect();
			const fx = (x - before.left) / before.width;
			const fy = (y - before.top) / before.height;
			zoomed = !zoomed;
			setWidth(fitWidth() * (zoomed ? ZOOM : 1));
			const after = img.getBoundingClientRect();
			stage.scrollLeft += after.left + fx * after.width - x;
			stage.scrollTop += after.top + fy * after.height - y;
			render();

			if (reduceMotion.matches) return;
			const settled = img.getBoundingClientRect();
			img.getAnimations().forEach((a) => a.cancel());
			img.animate(
				[
					{
						transformOrigin: "0 0",
						transform: `translate(${before.left - settled.left}px, ${before.top - settled.top}px) scale(${before.width / settled.width})`,
					},
					{ transformOrigin: "0 0", transform: "none" },
				],
				{ duration: 280, easing: EASE },
			);
		};

		const reset = () => {
			zoomed = false;
			setWidth(fitWidth());
			stage.scrollTo(0, 0);
			render();
		};

		root.querySelector("[data-zoom-open]")?.addEventListener("click", () => {
			dialog.showModal();
			if (img.complete) reset();
			else img.addEventListener("load", reset, { once: true });
		});
		root.querySelector("[data-zoom-close]")?.addEventListener("click", () => dialog.close());
		toggle.addEventListener("click", () => {
			const r = stage.getBoundingClientRect();
			zoomAt(r.left + r.width / 2, r.top + r.height / 2);
		});
		window.addEventListener("resize", () => {
			if (dialog.open && !zoomed) setWidth(fitWidth());
		});

		let start: { x: number; y: number; left: number; top: number; moved: boolean } | null = null;
		stage.addEventListener("pointerdown", (e) => {
			start = {
				x: e.clientX,
				y: e.clientY,
				left: stage.scrollLeft,
				top: stage.scrollTop,
				moved: false,
			};
			if (e.pointerType === "mouse" && zoomed) stage.setPointerCapture(e.pointerId);
		});
		stage.addEventListener("pointermove", (e) => {
			if (!start) return;
			const dx = e.clientX - start.x;
			const dy = e.clientY - start.y;
			if (!start.moved && Math.hypot(dx, dy) > 8) start.moved = true;
			if (start.moved && e.pointerType === "mouse" && zoomed) {
				stage.toggleAttribute("data-panning", true);
				stage.scrollLeft = start.left - dx;
				stage.scrollTop = start.top - dy;
			}
		});
		stage.addEventListener("pointercancel", () => {
			start = null;
		});
		stage.addEventListener("pointerup", (e) => {
			stage.removeAttribute("data-panning");
			const tap = start && !start.moved;
			start = null;
			if (tap && e.target === img) zoomAt(e.clientX, e.clientY);
			else if (tap && !zoomed) dialog.close();
		});
	});
</script>
