---
import { Image } from "emdash/ui";
import type { FotoKey } from "../content/foto";
import Hills from "./Hills.astro";
import Photo from "./Photo.astro";

type ImageValue = { id: string; src?: string; alt?: string; width?: number; height?: number };

interface Props {
	image?: ImageValue | null;
	alt: string;
	ratio?: "4/3" | "3/2" | "16/9" | "1/1" | "3/4" | "4/5";
	sizes?: string;
	priority?: boolean;
	fallback?: FotoKey;
	captioned?: boolean;
	fit?: "cover" | "contain";
	placeholder?: string;
	class?: string;
}

const {
	image,
	alt,
	ratio = "4/3",
	sizes = "(min-width: 64rem) 50vw, 100vw",
	priority = false,
	fallback,
	captioned = false,
	fit = "cover",
	placeholder = "Foto menyusul",
	class: className,
} = Astro.props;
const imgClass = `absolute inset-0 size-full ${fit === "contain" ? "object-contain" : "object-cover"}`;
---

<div
	class:list={[
		"bg-sand relative aspect-(--ratio) overflow-hidden rounded-(--radius-card)",
		className,
	]}
	style={`--ratio: ${ratio}`}
>
	{image ? (
		<Image
			image={image}
			alt={image.alt || alt}
			sizes={sizes}
			priority={priority}
			class={imgClass}
		/>
	) : fallback ? (
		<Photo
			foto={fallback}
			alt={captioned ? "" : undefined}
			sizes={sizes}
			priority={priority}
			class={imgClass}
		/>
	) : (
		<div
			class="absolute inset-0 bg-linear-to-b from-[#f3ecdf] to-[#e9e0cf]"
			role="img"
			aria-label={`${alt} (foto menyusul)`}
		>
			<span class="text-muted absolute inset-x-0 top-[38%] text-center text-sm font-medium">
				{placeholder}
			</span>
			<Hills
				color="var(--color-sage)"
				back="#d3dfcc"
				class="absolute inset-x-0 bottom-0 h-1/3 max-h-28"
			/>
		</div>
	)}
</div>
