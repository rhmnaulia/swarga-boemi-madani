---
import { Image } from "emdash/ui";
import { FOTO_ALT, type FotoKey } from "../content/foto";
import Icon from "./Icon.astro";
import Media from "./Media.astro";
import Photo from "./Photo.astro";

type ImageValue = { id: string; src?: string; alt?: string; width?: number; height?: number };

interface Props {
	images: ImageValue[];
	alt: string;
	fallback?: FotoKey[];
}

const { images, alt, fallback = [] } = Astro.props;
const items: ({ image: ImageValue } | { foto: FotoKey })[] =
	images.length > 0 ? images.map((image) => ({ image })) : fallback.map((foto) => ({ foto }));
const altFor = (item: (typeof items)[number], i: number) =>
	"foto" in item ? FOTO_ALT[item.foto] : item.image.alt || `${alt}, foto ${i + 1}`;
---

{items.length === 0 ? (
	<Media alt={alt} ratio="4/3" priority />
) : (
	<div data-gallery>
		<div class="relative">
			<ul
				data-gallery-strip
				class="no-scrollbar -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 md:mx-0 md:grid md:grid-cols-4 md:overflow-visible md:px-0"
			>
				{items.map((item, i) => (
					<li class="w-[88%] shrink-0 snap-center md:w-auto md:first:col-span-4">
						<button
							type="button"
							class="pressable block w-full"
							data-gallery-open={i}
							aria-label={`Perbesar ${altFor(item, i)}`}
						>
							<Media
								image={"image" in item ? item.image : undefined}
								fallback={"foto" in item ? item.foto : undefined}
								alt={altFor(item, i)}
								ratio="4/3"
								priority={i === 0}
								sizes={
									i === 0
										? "(min-width: 64rem) 40rem, (min-width: 48rem) 100vw, 88vw"
										: "(min-width: 48rem) 10rem, 88vw"
								}
							/>
						</button>
					</li>
				))}
			</ul>
			{items.length > 1 && (
				<span
					class="pointer-events-none absolute top-3 right-3 rounded-full bg-black/60 px-2.5 py-1 text-xs font-semibold text-white tabular-nums md:hidden"
					aria-hidden="true"
					data-gallery-count
				>
					1 / {items.length}
				</span>
			)}
		</div>
		{items.length > 1 && (
			<p class="text-muted mt-2 text-sm">
				{items.length} foto. <span class="md:hidden">Geser untuk melihat.</span>
				<span class="hidden md:inline">Ketuk foto untuk memperbesar.</span>
			</p>
		)}

		<dialog class="lightbox" aria-label="Galeri foto" data-gallery-dialog>
			<button
				type="button"
				class="absolute top-3 right-3 z-10 grid size-11 place-items-center rounded-full bg-black/60 text-white"
				aria-label="Tutup galeri"
				data-gallery-close
			>
				<Icon name="close" class="size-6" />
			</button>
			<ul class="no-scrollbar flex h-full snap-x snap-mandatory overflow-x-auto" data-gallery-track>
				{items.map((item, i) => (
					<li class="grid h-full w-full shrink-0 snap-center place-items-center p-2">
						{"image" in item ? (
							<Image
								image={item.image}
								alt={altFor(item, i)}
								sizes="100vw"
								class="max-h-full w-auto max-w-full object-contain"
							/>
						) : (
							<Photo foto={item.foto} class="max-h-full w-auto max-w-full object-contain" />
						)}
					</li>
				))}
			</ul>
		</dialog>
	</div>
)}

<style>
	.no-scrollbar {
		scrollbar-width: none;
	}
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
		const dialog = root.querySelector<HTMLDialogElement>("[data-gallery-dialog]");
		const track = root.querySelector<HTMLElement>("[data-gallery-track]");
		if (!dialog || !track) return;
		root.querySelectorAll<HTMLElement>("[data-gallery-open]").forEach((btn) => {
			btn.addEventListener("click", () => {
				dialog.showModal();
				const i = Number(btn.dataset.galleryOpen);
				track.scrollTo({ left: i * track.clientWidth, behavior: "instant" });
			});
		});
		dialog.querySelector("[data-gallery-close]")?.addEventListener("click", () => dialog.close());

		const strip = root.querySelector<HTMLElement>("[data-gallery-strip]");
		const count = root.querySelector<HTMLElement>("[data-gallery-count]");
		const total = root.querySelectorAll("[data-gallery-open]").length;
		strip?.addEventListener(
			"scroll",
			() => {
				const slide = strip.firstElementChild as HTMLElement | null;
				if (!count || !slide) return;
				const i = Math.round(strip.scrollLeft / (slide.offsetWidth + 12));
				count.textContent = `${Math.min(i + 1, total)} / ${total}`;
			},
			{ passive: true },
		);
	});
</script>
