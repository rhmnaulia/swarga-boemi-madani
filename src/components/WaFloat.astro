---
import { getPengaturan } from "../lib/cms";
import { buildWaLink, type WaContext } from "../lib/wa";
import Icon from "./Icon.astro";

interface Props {
	ctx?: WaContext;
	/** Keep hidden until the hero (`[data-hero]`) scrolls out, so it does not compete with the hero CTA. */
	afterHero?: boolean;
}

const { ctx = { kind: "umum" }, afterHero = false } = Astro.props;
const pengaturan = await getPengaturan(Astro.cache);
const houseType = ctx.kind === "tipe" ? ctx.nama.toLowerCase() : "";
---

<a
	href={buildWaLink(ctx, pengaturan?.whatsapp)}
	target="_blank"
	rel="noopener"
	data-wa
	data-house-type={houseType}
	data-wa-float
	data-after-hero={afterHero ? "" : undefined}
	class="wa-float bg-brand-green pressable fixed right-4 z-30 inline-flex h-14 items-center gap-2 rounded-full pr-5 pl-4 font-semibold text-white"
	aria-label="Chat Marketing via WhatsApp"
>
	<Icon name="whatsapp" class="size-6" />
	<span>Chat</span>
</a>

<style>
	.wa-float {
		bottom: calc(1rem + env(safe-area-inset-bottom));
		box-shadow: 0 6px 20px rgb(20 40 25 / 0.28);
		transition:
			transform 200ms var(--ease-out),
			opacity 200ms var(--ease-out);
	}
	.wa-float[data-hidden] {
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.wa-float[data-hidden] {
			transform: none;
		}
	}
</style>

<script>
	const float = document.querySelector<HTMLElement>("[data-wa-float][data-after-hero]");
	const hero = document.querySelector("[data-hero]");
	if (float && hero && "IntersectionObserver" in window) {
		new IntersectionObserver(([entry]) => {
			float.toggleAttribute("data-hidden", entry.isIntersecting);
			float.inert = entry.isIntersecting;
		}).observe(hero);
	}
</script>
