---
import { NAV, PROJECT_NAME, WA_DISPLAY, WA_TEL } from "../content/site";
import Icon from "./Icon.astro";
import WaButton from "./WaButton.astro";

interface Props {
	logo?: { url?: string; alt?: string } | null;
}

const { logo } = Astro.props;
const LOGO_SIZE = { width: 473, height: 149 };
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header border-line sticky top-0 z-40 border-b">
	<div class="container-page flex h-16 items-center justify-between gap-4">
		<a
			href="/"
			class="flex min-h-11 shrink-0 items-center gap-2 font-bold tracking-tight whitespace-nowrap"
		>
			<img
				src={logo?.url || "/logo-sbm.png"}
				alt={logo?.alt || PROJECT_NAME}
				width={LOGO_SIZE.width}
				height={LOGO_SIZE.height}
				class="h-10 w-auto"
			/>
		</a>

		<nav aria-label="Menu utama" class="hidden xl:block">
			<ul class="flex items-center gap-1 text-[0.92rem] font-medium">
				{NAV.map((item) => (
					<li>
						<a
							href={item.href}
							aria-current={isActive(item.href) ? "page" : undefined}
							class="hover:text-brand-green aria-[current=page]:text-brand-green rounded-md px-2.5 py-2 whitespace-nowrap transition-colors"
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="hidden shrink-0 xl:block">
			<WaButton label="Chat Marketing" class="min-h-10 px-4 text-sm whitespace-nowrap" />
		</div>

		<button
			type="button"
			class="pressable -mr-2 grid size-11 place-items-center rounded-lg xl:hidden"
			aria-label="Buka menu"
			aria-haspopup="dialog"
			data-nav-open
		>
			<Icon name="menu" class="size-6" />
		</button>
	</div>
</header>

<dialog class="nav-sheet bg-paper" aria-label="Menu" data-nav>
	<div class="flex h-full flex-col">
		<div class="border-line flex h-16 items-center justify-between border-b px-4">
			<span class="font-bold">Menu</span>
			<button
				type="button"
				class="pressable -mr-2 grid size-11 place-items-center rounded-lg"
				aria-label="Tutup menu"
				data-nav-close
			>
				<Icon name="close" class="size-6" />
			</button>
		</div>
		<nav aria-label="Menu utama" class="flex-1 overflow-y-auto px-2 py-3">
			<ul>
				<li>
					<a href="/" class="flex min-h-12 items-center rounded-lg px-3 text-lg font-semibold">
						Beranda
					</a>
				</li>
				{NAV.map((item) => (
					<li>
						<a
							href={item.href}
							aria-current={isActive(item.href) ? "page" : undefined}
							class="aria-[current=page]:text-brand-green flex min-h-12 items-center rounded-lg px-3 text-lg font-semibold"
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
		<div class="border-line space-y-2 border-t p-4 pb-[calc(1rem+env(safe-area-inset-bottom))]">
			<WaButton label="Chat via WhatsApp" class="w-full" />
			<a
				href={`tel:${WA_TEL}`}
				class="border-line pressable inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-(--radius-btn) border bg-white font-semibold"
			>
				<Icon name="phone" class="size-5" />
				Telepon {WA_DISPLAY}
			</a>
		</div>
	</div>
</dialog>

<style>
	.site-header {
		transition: transform 220ms var(--ease-out);
	}
	.site-header[data-hidden] {
		transform: translateY(-100%);
	}
	@media (prefers-reduced-motion: reduce) {
		.site-header {
			transition: none;
		}
	}
	.site-header {
		background: color-mix(in srgb, var(--color-paper) 88%, transparent);
		backdrop-filter: blur(16px) saturate(160%);
		-webkit-backdrop-filter: blur(16px) saturate(160%);
	}
	@media (prefers-reduced-transparency: reduce) {
		.site-header {
			background: var(--color-paper);
			backdrop-filter: none;
		}
	}

	.nav-sheet {
		margin: 0 0 0 auto;
		width: min(20rem, 86vw);
		height: 100dvh;
		max-height: none;
		max-width: none;
		padding: 0;
		border: 0;
		transform: translateX(100%);
		transition:
			transform 180ms var(--ease-drawer),
			display 180ms allow-discrete,
			overlay 180ms allow-discrete;
	}
	.nav-sheet[open] {
		transform: none;
		transition-duration: 240ms;
	}
	@starting-style {
		.nav-sheet[open] {
			transform: translateX(100%);
		}
	}
	.nav-sheet::backdrop {
		background: rgb(16 24 18 / 0.4);
		opacity: 0;
		transition:
			opacity 180ms ease,
			display 180ms allow-discrete,
			overlay 180ms allow-discrete;
	}
	.nav-sheet[open]::backdrop {
		opacity: 1;
		transition-duration: 240ms;
	}
	@starting-style {
		.nav-sheet[open]::backdrop {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.nav-sheet {
			transform: none;
			opacity: 0;
			transition:
				opacity 200ms ease,
				display 200ms allow-discrete,
				overlay 200ms allow-discrete;
		}
		.nav-sheet[open] {
			opacity: 1;
		}
		@starting-style {
			.nav-sheet[open] {
				opacity: 0;
			}
		}
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>(".site-header");
	const phone = window.matchMedia("(max-width: 1023px)");
	let lastY = window.scrollY;
	window.addEventListener(
		"scroll",
		() => {
			const y = window.scrollY;
			const delta = y - lastY;
			if (!header || Math.abs(delta) < 6) return;
			header.toggleAttribute("data-hidden", phone.matches && delta > 0 && y > 120);
			lastY = y;
		},
		{ passive: true },
	);
	header?.addEventListener("focusin", () => header.removeAttribute("data-hidden"));

	const sheet = document.querySelector<HTMLDialogElement>("[data-nav]");
	const opener = document.querySelector<HTMLButtonElement>("[data-nav-open]");
	if (sheet && opener) {
		opener.addEventListener("click", () => sheet.showModal());
		sheet.querySelector("[data-nav-close]")?.addEventListener("click", () => sheet.close());
		sheet.addEventListener("click", (e) => {
			if (e.target === sheet) sheet.close();
		});
		sheet.addEventListener("close", () => opener.focus());
	}
</script>
