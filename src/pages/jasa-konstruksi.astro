---
import Icon from "../components/Icon.astro";
import Media from "../components/Media.astro";
import PageHeader from "../components/PageHeader.astro";
import WaButton from "../components/WaButton.astro";
import { ALUR, KOTA_LAYANAN, LAYANAN } from "../content/konstruksi";
import { MATERIAL } from "../content/keunggulan";
import Base from "../layouts/Base.astro";
import { getProjects } from "../lib/cms";
import type { WaContext } from "../lib/wa";

const projects = await getProjects(Astro.cache);
const wa: WaContext = { kind: "konstruksi" };
---

<Base
	title="Jasa Konstruksi"
	description="Jasa bangun rumah dan renovasi di Gombong dan Kebumen oleh PT ASBM, kontraktor anggota REI. Konsultasi gratis via WhatsApp."
	wa={wa}
>
	<PageHeader
		title="Jasa bangun & renovasi rumah"
		intro="Tim yang membangun Swarga Boemi Madani juga mengerjakan rumah Anda, dengan pengecekan kualitas yang sama."
	>
		<div class="mt-6">
			<WaButton ctx={wa} label="Konsultasi via WhatsApp" />
		</div>
	</PageHeader>

	<section class="container-page pt-8 pb-12 md:pt-10 md:pb-16">
		<h2 class="text-2xl md:text-3xl">Layanan</h2>
		<ul class="mt-6 md:mt-8 grid gap-4 md:grid-cols-3">
			{LAYANAN.map((l, i) => (
				<li
					class="reveal border-line rounded-(--radius-card) border bg-white p-5"
					style={`--i: ${i}`}
				>
					<p class="text-lg font-bold">{l.title}</p>
					<p class="text-muted mt-1">{l.text}</p>
				</li>
			))}
		</ul>
		<p class="mt-6 flex items-start gap-2">
			<Icon name="pin" class="text-brand-green mt-1 size-5 shrink-0" />
			<span>
				<span class="font-semibold">Area layanan:</span> {KOTA_LAYANAN.join(", ")}
			</span>
		</p>
	</section>

	{projects.length > 0 && (
		<section class="bg-sand py-12 md:py-16">
			<div class="container-page">
				<h2 class="text-2xl md:text-3xl">Proyek yang sudah kami kerjakan</h2>
				<ul class="mt-6 md:mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{projects.map((p, i) => (
						<li class="reveal" style={`--i: ${i % 3}`}>
							<Media
								image={p.data.foto?.[0]?.foto}
								alt={`${p.data.judul}, ${p.data.kota}`}
								ratio="4/3"
								sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
							/>
							<p class="mt-3 font-bold">{p.data.judul}</p>
							<p class="text-muted text-sm">
								{[p.data.jenis_proyek, p.data.kota, p.data.tahun].filter(Boolean).join(" · ")}
							</p>
							{p.data.deskripsi && <p class="mt-1 text-sm">{p.data.deskripsi}</p>}
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<!-- Same background as "Layanan" when the portfolio is hidden: drop the top padding so the
	     two paddings do not stack into one dead gap. -->
	<section
		class:list={[
			"container-page grid gap-10 pb-12 md:pb-16 lg:grid-cols-[1.4fr_1fr]",
			projects.length > 0 ? "pt-12 md:pt-16" : "pt-4",
		]}
	>
		<div>
			<h2 class="text-2xl md:text-3xl">Alur kerja sama</h2>
			<ol class="mt-6 md:mt-8 space-y-5">
				{ALUR.map((s, i) => (
					<li class="reveal flex gap-4" style={`--i: ${i}`}>
						<span class="bg-brand-green grid size-9 shrink-0 place-items-center rounded-full text-sm font-bold text-white">
							{i + 1}
						</span>
						<div>
							<p class="font-semibold">{s.title}</p>
							<p class="text-muted text-sm">{s.text}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
		<div class="border-line self-start rounded-(--radius-card) border bg-white p-5">
			<p class="font-semibold">Material standar kami</p>
			<dl class="mt-3 divide-y divide-(--color-line)">
				{MATERIAL.map((m) => (
					<div class="flex justify-between gap-4 py-3 text-sm">
						<dt class="text-muted">{m.part}</dt>
						<dd class="text-right font-semibold">{m.brand}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<!-- Light card, not a dark band: the dark footer follows right after. -->
	<section class="container-page pb-12 md:pb-16">
		<div class="bg-brand-green-soft flex flex-col items-start gap-5 rounded-(--radius-card) p-6 md:flex-row md:items-center md:justify-between md:p-10">
			<div>
				<h2 class="text-brand-green-dark text-2xl md:text-3xl">Ceritakan rencana Anda</h2>
				<p class="text-muted mt-2">Konsultasi awal gratis, cukup lewat WhatsApp.</p>
			</div>
			<WaButton ctx={wa} label="Konsultasi via WhatsApp" />
		</div>
	</section>
</Base>
