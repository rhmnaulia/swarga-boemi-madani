---
import Icon from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import Photo from "../components/Photo.astro";
import WaButton from "../components/WaButton.astro";
import {
	LEGALITAS_PERUSAHAAN,
	LEGALITAS_PROYEK,
	NILAI_CARE,
	PENDIRI,
	PROFIL,
} from "../content/tentang";
import type { FotoKey } from "../content/foto";
import Base from "../layouts/Base.astro";

const SERAH_TERIMA: FotoKey[] = ["akad-serah-terima", "akad-jual-beli", "tmo", "goody-bag"];
const KEGIATAN: FotoKey[] = [
	"rei-academy",
	"rei-pertemuan",
	"rei-balaikota",
	"rei-diklat-pajak",
	"presentasi-1",
	"presentasi-2",
	"presentasi-3",
	"presentasi-4",
	"presentasi-5",
	"presentasi-6",
];
---

<Base
	title="Tentang PT ASBM"
	description="PT. Abyakta Sadawira Bangun Mandiri, developer perumahan dan kontraktor di Kebumen sejak 2022. Anggota REI dengan legalitas lengkap."
>
	<PageHeader title="Tentang kami" intro="Developer perumahan dan kontraktor dari Kebumen." />

	<section class="container-page grid gap-10 pt-8 pb-12 md:pt-10 md:pb-16 lg:grid-cols-[1.4fr_1fr]">
		<div class="max-w-2xl space-y-4 text-lg">
			{PROFIL.map((p) => (
				<p>{p}</p>
			))}
		</div>
		<div class="space-y-5 self-start">
			<Photo foto="logo-asbm" sizes="16rem" class="w-56 rounded-(--radius-card)" />
			<div class="bg-brand-green-soft rounded-(--radius-card) p-5">
				<Icon name="badge" class="text-brand-green size-8" />
				<p class="mt-2 text-lg font-bold">Anggota REI</p>
				<p class="text-brand-green-dark">
					Real Estat Indonesia, NPA 02-01085. Akad jual beli dilakukan di notaris.
				</p>
			</div>
		</div>
	</section>

	{PENDIRI.length > 0 && (
		<section class="border-line border-t py-12 md:py-16">
			<div class="container-page">
				<h2 class="text-2xl md:text-3xl">Pendiri</h2>
				<ul class="mt-6 md:mt-8 grid gap-6 md:grid-cols-2">
					{PENDIRI.map((p) => (
						<li>
							<p class="text-lg font-bold">{p.name}</p>
							<p class="text-muted">{p.role}</p>
							{p.bio && <p class="mt-2">{p.bio}</p>}
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	{NILAI_CARE.length > 0 && (
		<section class="bg-sand py-12 md:py-16">
			<div class="container-page">
				<h2 class="text-2xl md:text-3xl">Nilai kami: CARE</h2>
				<ul class="mt-6 md:mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{NILAI_CARE.map((v) => (
						<li>
							<p class="text-brand-green text-4xl font-bold">{v.letter}</p>
							<p class="mt-1 font-bold">{v.word}</p>
							<p class="text-muted mt-1 text-sm">{v.text}</p>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<section class="bg-sand py-12 md:py-16">
		<div class="container-page">
			<h2 class="text-2xl md:text-3xl">Dari akad sampai serah terima</h2>
			<p class="text-muted mt-2 max-w-xl">
				Akad di notaris, serah terima kunci, dan Town Management Office kami.
			</p>
		</div>
		<div class="container-page mt-6 md:mt-8">
			<PhotoGrid fotos={SERAH_TERIMA} cols={4} />
		</div>
	</section>

	<section class="py-12 md:py-16">
		<div class="container-page">
			<h2 class="text-2xl md:text-3xl">Kegiatan kami</h2>
			<p class="text-muted mt-2 max-w-xl">
				Aktif di Real Estat Indonesia dan rutin presentasi ke instansi serta sekolah.
			</p>
			<PhotoGrid fotos={KEGIATAN} cols={4} class="mt-6 md:mt-8" />
		</div>
	</section>

	<section class="border-line border-t py-12 md:py-16">
		<div class="container-page grid gap-10 lg:grid-cols-2">
			<div>
				<h2 class="text-2xl md:text-3xl">Legalitas perusahaan</h2>
				<dl class="mt-6 md:mt-8 divide-y divide-(--color-line)">
					{LEGALITAS_PERUSAHAAN.map((l) => (
						<div class="grid gap-1 py-3 sm:grid-cols-[10rem_1fr]">
							<dt class="text-muted">{l.label}</dt>
							<dd class="font-semibold">{l.value}</dd>
						</div>
					))}
				</dl>
			</div>
			<div>
				<h2 class="text-2xl md:text-3xl">Perizinan proyek</h2>
				<ul class="mt-6 md:mt-8 space-y-3">
					{LEGALITAS_PROYEK.map((l) => (
						<li class="flex items-start gap-3">
							<Icon name="check" class="text-brand-green mt-0.5 size-5 shrink-0" />
							{l}
						</li>
					))}
				</ul>
			</div>
		</div>
		<div class="container-page mt-10">
			<WaButton variant="outline" />
		</div>
	</section>
</Base>
