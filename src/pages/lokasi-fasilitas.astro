---
import Icon from "../components/Icon.astro";
import MapEmbed from "../components/MapEmbed.astro";
import PageHeader from "../components/PageHeader.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import WaButton from "../components/WaButton.astro";
import ZoomImage from "../components/ZoomImage.astro";
import type { FotoKey } from "../content/foto";
import { FASILITAS, PATOKAN } from "../content/lokasi";
import { ADDRESS_LINE } from "../content/site";
import Base from "../layouts/Base.astro";
import { getPengaturan } from "../lib/cms";

const pengaturan = await getPengaturan(Astro.cache);

const fotoLingkungan: FotoKey[] = [
	"poster-pemandangan",
	"kawasan-udara",
	"alexandria-jalan",
	"fasad-3-tipe",
];
const captions = {
	"poster-pemandangan": "Sawah dan gunung di sekitar lokasi",
	"kawasan-udara": "Kawasan dari udara (ilustrasi)",
	"alexandria-jalan": "Jalan di Cluster Alexandria (ilustrasi)",
	"fasad-3-tipe": "Fasad tipe Granada, Andalusia, dan Alexandria (ilustrasi)",
};
---

<Base
	title="Lokasi & Fasilitas"
	description="Lokasi Swarga Boemi Madani di Jl. Merbabu, Desa Wero, Gombong, Kebumen. Dekat Masjid At Tauhid, SMK Yapek Gombong, dan Jl. Yos Sudarso."
>
	<PageHeader title="Lokasi & fasilitas" intro="Hunian asri & strategis di Gombong, Kebumen." />

	<section class="container-page grid gap-10 pt-8 pb-12 md:pt-10 md:pb-16 lg:grid-cols-[1fr_1.2fr]">
		<div>
			<h2 class="text-2xl">Alamat</h2>
			<p class="mt-3 flex gap-2 text-lg">
				<Icon name="pin" class="text-brand-green mt-1 size-5 shrink-0" />
				{pengaturan?.alamat || ADDRESS_LINE}
			</p>

			<h3 class="mt-8 text-lg font-bold">Patokan sekitar</h3>
			<ul class="mt-3 space-y-2">
				{PATOKAN.map((p) => (
					<li class="border-line flex justify-between gap-4 border-b pb-2">
						<span>{p.name}</span>
						{p.note && <span class="text-muted text-sm">{p.note}</span>}
					</li>
				))}
			</ul>
		</div>
		<MapEmbed mapsUrl={pengaturan?.google_maps_url} />
	</section>

	<section class="bg-sand py-12 md:py-16">
		<div class="container-page grid gap-10 lg:grid-cols-2">
			<div>
				<h2 class="text-2xl md:text-3xl">Fasilitas kawasan</h2>
				<ul class="mt-6 md:mt-8 space-y-3">
					{FASILITAS.map((f) => (
						<li class="flex items-start gap-3">
							<Icon name="check" class="text-brand-green mt-0.5 size-5 shrink-0" />
							{f}
						</li>
					))}
				</ul>
			</div>
			<div>
				<h2 class="text-2xl md:text-3xl">Masterplan</h2>
				<ZoomImage
					fallback="brosur-masterplan"
					alt="Brosur masterplan, peta lokasi, dan fasilitas Swarga Boemi Madani"
					natural
					sizes="(min-width: 64rem) 36rem, 100vw"
					class="mt-6"
				/>
				<p class="text-muted mt-2 text-sm">
					Warna kavling di masterplan: kuning Alexandria, biru Andalusia, merah muda Granada, hijau
					Cordoba.
				</p>
			</div>
		</div>
	</section>

	<section class="container-page py-12 md:py-16">
		<h2 class="text-2xl md:text-3xl">Suasana lingkungan</h2>
		<PhotoGrid fotos={fotoLingkungan} {captions} cols={2} class="mt-6 md:mt-8" />
		<div class="mt-10 flex flex-col gap-3 sm:flex-row">
			<a
				href="/kontak#survei"
				class="bg-brand-green pressable inline-flex min-h-12 items-center justify-center rounded-(--radius-btn) px-5 font-semibold text-white hover:bg-brand-green-dark"
			>
				Jadwalkan Survei Lokasi
			</a>
			<WaButton variant="outline" />
		</div>
	</section>
</Base>
