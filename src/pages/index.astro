---
import Hills from "../components/Hills.astro";
import HouseCard from "../components/HouseCard.astro";
import Icon from "../components/Icon.astro";
import Media from "../components/Media.astro";
import WaButton from "../components/WaButton.astro";
import Base from "../layouts/Base.astro";
import { BEBAS_BIAYA, KEUNGGULAN, MATERIAL, QC_STEPS } from "../content/keunggulan";
import { PROJECT_NAME, TAGLINE } from "../content/site";
import { getHouseTypes, getPengaturan, getTestimonials } from "../lib/cms";

const [houses, testimonials, pengaturan] = await Promise.all([
	getHouseTypes(Astro.cache),
	getTestimonials(Astro.cache),
	getPengaturan(Astro.cache),
]);
const sisa = pengaturan?.total_sisa_unit;
---

<Base
	title={PROJECT_NAME}
	description="Perumahan di Gombong, Kebumen. Rumah tipe 36 sampai 80 dengan smart lock, one gate system, dan gratis SHM, BPHTB, AJB, balik nama & notaris."
	dockAfterHero
>
	<!-- Hero: forest band, edge-to-edge photo, hills hand over to the cream page -->
	<section data-hero class="bg-brand-green-dark text-paper relative overflow-hidden">
		<div class="container-page relative z-10 grid gap-10 pt-10 md:pt-14 lg:grid-cols-[1.1fr_1fr] lg:gap-14 lg:pt-0">
			<div class="pb-2 lg:pt-14 lg:pb-36">
				<p class="text-sage text-sm font-semibold tracking-wide">{TAGLINE}</p>
				<h1 class="mt-3 text-[2.4rem] leading-[1.04] md:text-6xl xl:text-[4rem]">
					Hunian modern dengan pemandangan yang indah
				</h1>
				<p class="mt-5 max-w-lg text-lg text-white/80">
					{PROJECT_NAME}, hunian asri & strategis di Gombong, Kebumen.
				</p>

				<p class="mt-7 flex max-w-lg items-start gap-3 rounded-(--radius-card) border border-white/20 bg-white/5 p-4 font-semibold">
					<Icon name="doc" class="text-sage mt-0.5 size-5 shrink-0" />
					{BEBAS_BIAYA}
				</p>

				<div class="mt-7 flex flex-col gap-3 sm:flex-row">
					<WaButton />
					<a
						href="#tipe"
						class="pressable inline-flex min-h-12 items-center justify-center rounded-(--radius-btn) border border-white/35 px-5 font-semibold transition-colors hover:bg-white/10"
					>
						Cek Sisa Unit
					</a>
				</div>
				{typeof sisa === "number" && sisa > 0 && (
					<p class="text-sage mt-4 text-sm font-semibold">
						Tinggal {sisa} unit lagi di seluruh cluster.
					</p>
				)}
			</div>

			<!-- Photo bleeds to the viewport edge: full width on phones, to the right edge on desktop. -->
			<div class="hero-photo relative -mx-4 md:-mx-8 lg:mx-0 lg:self-stretch">
				<!-- TODO(data): hero photo (real finished unit preferred over render). -->
				<Media
					alt="Tampak depan rumah di Swarga Boemi Madani Residence"
					ratio="4/3"
					priority
					placeholder="Foto unit menyusul"
					sizes="(min-width: 64rem) 50vw, 100vw"
					class="rounded-none lg:h-full lg:min-h-[34rem] lg:aspect-auto"
				/>
			</div>
		</div>
		<Hills
			color="var(--color-paper)"
			back="var(--color-brand-green)"
			class="absolute inset-x-0 bottom-0 z-20 h-12 md:h-20"
		/>
	</section>

	<!-- Tipe rumah -->
	<section id="tipe" class="py-12 md:py-16">
		<div class="container-page">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<div>
					<h2 class="text-3xl md:text-4xl">Pilih tipe rumah</h2>
					<p class="text-muted mt-1">Empat cluster, dari 36/84 sampai 80/136.</p>
				</div>
				<a
					href="/tipe-rumah"
					class="text-brand-green inline-flex min-h-11 items-center gap-1.5 font-semibold hover:underline"
				>
					Bandingkan semua tipe <Icon name="arrow" class="size-4" />
				</a>
			</div>
		</div>
		<div class="container-page mt-6 md:mt-8 flex snap-x snap-mandatory scroll-pl-4 gap-4 overflow-x-auto pb-2 sm:grid sm:grid-cols-2 sm:overflow-visible lg:grid-cols-4">
			{houses.map((h, i) => (
				<HouseCard
					slug={h.id}
					house={h.data}
					class="reveal w-[80%] shrink-0 snap-start sm:w-auto"
					style={`--i: ${i}`}
				/>
			))}
		</div>
	</section>

	<!-- Keunggulan: second dark band, items read as a ruled list -->
	<section class="bg-brand-green-dark text-paper">
		<Hills
			color="var(--color-paper)"
			back="var(--color-brand-green)"
			class="h-8 rotate-180 md:h-12"
		/>
		<div class="container-page py-12 md:py-16">
			<div class="grid gap-10 lg:grid-cols-[1fr_2.2fr]">
				<div>
					<h2 class="text-3xl md:text-4xl">Fasilitas & keunggulan</h2>
					<p class="mt-3 max-w-sm text-white/75">
						Lingkungan yang tertata, aman, dan dekat dengan masjid. Tempat keluarga tumbuh dengan
						tenang.
					</p>
				</div>
				<ul class="grid grid-cols-2 gap-x-5 gap-y-8 md:grid-cols-4">
					{KEUNGGULAN.map((k, i) => (
						<li class="reveal border-t border-white/15 pt-4" style={`--i: ${i % 4}`}>
							<Icon name={k.icon} class="text-sage size-7" />
							<p class="mt-3 leading-snug font-bold text-balance">{k.title}</p>
							<p class="mt-1.5 text-sm text-white/70">{k.text}</p>
						</li>
					))}
				</ul>
			</div>
		</div>
		<Hills color="var(--color-paper)" back="var(--color-brand-green)" class="h-8 md:h-12" flip />
	</section>

	<!-- QC & material -->
	<section class="container-page grid gap-10 py-12 md:py-16 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
		<div>
			<h2 class="text-3xl md:text-4xl">Dicek bersama sebelum serah terima</h2>
			<p class="text-muted mt-3 max-w-xl">
				Setiap rumah melewati pengecekan kualitas yang terdokumentasi, dari material sampai kunci
				diserahkan.
			</p>
			<ol class="mt-6 md:mt-8 space-y-6">
				{QC_STEPS.map((s, i) => (
					<li class="reveal flex gap-4" style={`--i: ${i}`}>
						<span class="text-brand-orange w-8 shrink-0 text-3xl leading-none font-extrabold tabular-nums">
							{i + 1}
						</span>
						<div class="border-line flex-1 border-b pb-5">
							<p class="text-lg font-bold">{s.title}</p>
							<p class="text-muted">{s.text}</p>
						</div>
					</li>
				))}
			</ol>
			<a
				href="/progres"
				class="text-brand-green mt-4 inline-flex min-h-11 items-center gap-1.5 font-semibold hover:underline"
			>
				Lihat progres pembangunan <Icon name="arrow" class="size-4" />
			</a>
		</div>
		<div class="bg-brand-green-soft self-start rounded-(--radius-card) p-6">
			<p class="text-brand-green-dark text-lg font-extrabold">Material yang kami pakai</p>
			<dl class="mt-3 divide-y divide-(--color-sage)">
				{MATERIAL.map((m) => (
					<div class="flex justify-between gap-4 py-3.5">
						<dt class="text-muted">{m.part}</dt>
						<dd class="text-brand-green-dark text-right font-bold">{m.brand}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	{testimonials.length > 0 && (
		<section class="border-line border-t py-12 md:py-16">
			<div class="container-page">
				<h2 class="text-3xl md:text-4xl">Kata pembeli kami</h2>
				<ul class="mt-6 md:mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{testimonials.map((t, i) => (
						<li
							class="reveal border-line rounded-(--radius-card) border bg-white p-6"
							style={`--i: ${i % 3}`}
						>
							<blockquote class="text-[1.05rem] leading-relaxed">“{t.data.kutipan}”</blockquote>
							<p class="mt-4 font-bold">{t.data.nama}</p>
							{t.data.keterangan && <p class="text-muted text-sm">{t.data.keterangan}</p>}
							{t.data.video_url && (
								<a
									href={t.data.video_url}
									target="_blank"
									rel="noopener"
									class="text-brand-green mt-2 inline-flex min-h-11 items-center text-sm font-semibold hover:underline"
								>
									Tonton videonya
								</a>
							)}
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<!-- Jasa konstruksi: the one band that carries the star tile -->
	<section class="container-page pb-12 md:pb-16">
		<div class="bg-brand-green-soft tile-pattern grid items-center gap-6 rounded-(--radius-card) p-6 md:grid-cols-[1.5fr_1fr] md:p-10">
			<div>
				<h2 class="text-brand-green-dark text-2xl md:text-3xl">
					Mau bangun atau renovasi rumah sendiri?
				</h2>
				<p class="text-muted mt-2 max-w-xl">
					Tim yang membangun Swarga Boemi Madani juga menerima jasa konstruksi, dengan standar QC
					yang sama.
				</p>
			</div>
			<div class="md:text-right">
				<a
					href="/jasa-konstruksi"
					class="bg-brand-green-dark text-paper pressable hover:bg-brand-green inline-flex min-h-12 items-center justify-center gap-2 rounded-(--radius-btn) px-5 font-semibold"
				>
					Lihat jasa konstruksi <Icon name="arrow" class="size-4" />
				</a>
			</div>
		</div>
	</section>

	<!-- CTA akhir -->
	<section class="container-page pb-16 text-center md:pb-20">
		<h2 class="text-3xl md:text-4xl">Lihat langsung rumahnya</h2>
		<p class="text-muted mx-auto mt-3 max-w-lg">
			Datang ke lokasi, lihat unit, dan tanya apa saja ke tim marketing kami.
		</p>
		<div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
			<WaButton />
			<a
				href="/kontak#survei"
				class="border-brand-green text-brand-green pressable hover:bg-brand-green-soft inline-flex min-h-12 items-center justify-center rounded-(--radius-btn) border px-5 font-semibold"
			>
				Jadwalkan Survei Lokasi
			</a>
		</div>
	</section>
</Base>

<style>
	@media (width >= 64rem) {
		/* Extend past the container's right padding and the centered gutter. */
		.hero-photo {
			margin-right: calc(-1 * (max(0px, (100vw - 72rem) / 2) + 2rem));
		}
	}
</style>
