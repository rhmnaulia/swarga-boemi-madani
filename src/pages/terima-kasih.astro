---
import Icon from "../components/Icon.astro";
import WaButton from "../components/WaButton.astro";
import Base from "../layouts/Base.astro";
import { getHouseTypes } from "../lib/cms";
import { minatOptions } from "../lib/lead";

// `?minat=` comes from /api/lead after a successful form post; it shapes the WhatsApp message.
const houses = await getHouseTypes(Astro.cache);
const raw = Astro.url.searchParams.get("minat");
const minat = raw && minatOptions(houses.map((h) => h.data.nama)).includes(raw) ? raw : undefined;
---

<Base title="Terima kasih" dock={false}>
	<meta slot="head" name="robots" content="noindex" />
	<section class="container-page grid min-h-[60vh] place-items-center py-16 text-center">
		<div class="max-w-lg">
			<span class="bg-brand-green-soft text-brand-green mx-auto grid size-14 place-items-center rounded-full">
				<Icon name="check" class="size-8" />
			</span>
			<h1 class="mt-5 text-3xl md:text-4xl">Terima kasih, data Anda sudah kami terima</h1>
			<p class="text-muted mt-3 text-lg">
				Tim marketing kami akan menghubungi Anda lewat WhatsApp untuk memastikan jadwal survei.
				Ingin lebih cepat? Lanjutkan chat sekarang.
			</p>
			<div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
				<WaButton ctx={{ kind: "survei", minat }} label="Lanjut chat via WhatsApp" />
				<a
					href="/"
					class="border-line pressable inline-flex min-h-12 items-center justify-center rounded-(--radius-btn) border bg-white px-5 font-semibold hover:border-brand-green"
				>
					Kembali ke beranda
				</a>
			</div>
		</div>
	</section>
</Base>

<script>
	// Count the form once in GA4, then drop the query so a reload does not count it again.
	const params = new URLSearchParams(location.search);
	const minat = params.get("minat");
	if (minat !== null) {
		window.gtag?.("event", "form_survei", { minat });
		history.replaceState(null, "", location.pathname);
	}
</script>
