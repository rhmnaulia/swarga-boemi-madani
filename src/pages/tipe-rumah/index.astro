---
import HouseCard from "../../components/HouseCard.astro";
import Icon from "../../components/Icon.astro";
import PageHeader from "../../components/PageHeader.astro";
import WaButton from "../../components/WaButton.astro";
import { BEBAS_BIAYA } from "../../content/keunggulan";
import { ALUR_BELI } from "../../content/pembelian";
import Base from "../../layouts/Base.astro";
import { getHouseTypes } from "../../lib/cms";

const houses = await getHouseTypes(Astro.cache);
const daftar = houses.map((h) => `${h.data.nama} ${h.data.luas_bangunan}/${h.data.luas_tanah}`);
---

<Base
	title="Tipe Rumah Dijual di Gombong"
	description={`Rumah dijual di Swarga Boemi Madani, Gombong, Kebumen: ${daftar.join(", ")}. Lihat denah, spesifikasi, dan cek sisa unit.`}
>
	<PageHeader
		title="Tipe rumah"
		intro="Empat tipe di satu kawasan. Semua dengan surat lengkap dan pengecekan kualitas sebelum serah terima."
	>
		<p class="text-brand-green-dark mt-5 inline-flex items-center gap-2 font-semibold">
			<Icon name="doc" class="size-5" />
			{BEBAS_BIAYA}
		</p>
	</PageHeader>

	<section class="container-page pt-8 pb-12 md:pt-10 md:pb-16">
		<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
			{houses.map((h, i) => (
				<HouseCard
					slug={h.id}
					house={h.data}
					heading="h2"
					priority={i < 2}
					class="reveal"
					style={`--i: ${i}`}
				/>
			))}
		</div>

		<div class="border-line mt-12 overflow-x-auto rounded-(--radius-card) border bg-white">
			<table class="w-full min-w-[34rem] text-left text-sm">
				<caption class="p-4 text-left text-base font-semibold">Perbandingan singkat</caption>
				<thead class="bg-sand">
					<tr>
						<th scope="col" class="px-4 py-3">
							Tipe
						</th>
						<th scope="col" class="px-4 py-3">
							LB/LT (m²)
						</th>
						<th scope="col" class="px-4 py-3">
							Lantai
						</th>
						<th scope="col" class="px-4 py-3">
							Kamar
						</th>
						<th scope="col" class="px-4 py-3">
							Listrik
						</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-(--color-line)">
					{houses.map((h) => (
						<tr>
							<th scope="row" class="px-4 py-3">
								<a
									href={`/tipe-rumah/${h.id}`}
									class="text-brand-green font-semibold hover:underline"
								>
									{h.data.nama}
								</a>
							</th>
							<td class="px-4 py-3">
								{h.data.luas_bangunan}/{h.data.luas_tanah}
							</td>
							<td class="px-4 py-3">{h.data.lantai}</td>
							<td class="px-4 py-3">
								{h.data.kamar_tidur} KT, {h.data.kamar_mandi} KM
							</td>
							<td class="px-4 py-3">{h.data.listrik}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</section>

	<section class="bg-sand py-12 md:py-16">
		<div class="container-page grid gap-8 lg:grid-cols-[1fr_2fr] lg:gap-12">
			<div>
				<h2 class="text-2xl md:text-3xl">Alur pembelian</h2>
				<p class="text-muted mt-3 max-w-md">
					Dari pertanyaan pertama sampai kunci di tangan. Setiap langkah didampingi tim kami.
				</p>
				<div class="mt-6 flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-start">
					<WaButton />
					<a
						href="/kontak#survei"
						class="border-line pressable inline-flex min-h-12 items-center justify-center rounded-(--radius-btn) border bg-white px-5 font-semibold hover:border-brand-green"
					>
						Jadwalkan Survei Lokasi
					</a>
				</div>
			</div>
			<ol class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
				{ALUR_BELI.map((s, i) => (
					<li class="reveal flex gap-4" style={`--i: ${i % 2}`}>
						<span class="bg-brand-green grid size-9 shrink-0 place-items-center rounded-full text-sm font-bold text-white">
							{i + 1}
						</span>
						<div>
							<p class="font-semibold">{s.title}</p>
							<p class="text-muted text-sm">{s.text}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>
</Base>
