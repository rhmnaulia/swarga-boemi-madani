	"collections": [
		{
			"slug": "house_type",
			"label": "Tipe Rumah",
			"labelSingular": "Tipe Rumah",
			"description": "Empat tipe rumah di Swarga Boemi Madani. Ubah status, sisa unit, dan harga di sini.",
			"icon": "house",
			"sortOrder": 1,
			"urlPattern": "/tipe-rumah/{slug}",
			"supports": ["drafts", "revisions"],
			"titleField": "nama",
			"admin": {
				"listColumns": ["ketersediaan", "sisa_unit", "label_harga"],
				"quickCreate": false
			},
			"fields": [
				{
					"slug": "nama",
					"label": "Nama tipe (mis. Cordoba)",
					"type": "string",
					"required": true
				},
				{
					"slug": "urutan",
					"label": "Urutan tampil (1 = paling atas)",
					"type": "integer",
					"required": true,
					"defaultValue": 1
				},
				{
					"slug": "ketersediaan",
					"label": "Status ketersediaan",
					"type": "select",
					"required": true,
					"defaultValue": "tersedia",
					"validation": {
						"options": ["tersedia", "sisa-sedikit", "habis"]
					}
				},
				{
					"slug": "sisa_unit",
					"label": "Sisa unit (kosongkan jika tidak ingin ditampilkan)",
					"type": "integer",
					"validation": {
						"min": 0
					}
				},
				{
					"slug": "harga",
					"label": "Harga dalam Rupiah, angka saja (opsional)",
					"type": "number",
					"validation": {
						"min": 0
					}
				},
				{
					"slug": "label_harga",
					"label": "Teks harga (mis. \"Mulai Rp 350 jt\"). Kosong = \"Hubungi kami untuk harga\"",
					"type": "string"
				},
				{
					"slug": "luas_bangunan",
					"label": "Luas bangunan (m²)",
					"type": "integer",
					"required": true
				},
				{
					"slug": "luas_tanah",
					"label": "Luas tanah (m²)",
					"type": "integer",
					"required": true
				},
				{
					"slug": "lantai",
					"label": "Jumlah lantai (mis. \"2 + rooftop\")",
					"type": "string",
					"required": true
				},
				{
					"slug": "kamar_tidur",
					"label": "Kamar tidur (mis. \"4+1\")",
					"type": "string",
					"required": true
				},
				{
					"slug": "kamar_mandi",
					"label": "Kamar mandi",
					"type": "string",
					"required": true
				},
				{
					"slug": "listrik",
					"label": "Daya listrik (mis. \"1300 W\")",
					"type": "string",
					"required": true
				},
				{
					"slug": "fitur",
					"label": "Fitur & bonus",
					"type": "repeater",
					"validation": {
						"subFields": [
							{
								"slug": "teks",
								"label": "Fitur",
								"type": "string",
								"required": true
							}
						]
					}
				},
				{
					"slug": "foto_utama",
					"label": "Foto utama",
					"type": "image"
				},
				{
					"slug": "galeri",
					"label": "Galeri foto",
					"type": "repeater",
					"validation": {
						"subFields": [
							{
								"slug": "foto",
								"label": "Foto",
								"type": "image",
								"required": true
							}
						]
					}
				},
				{
					"slug": "denah",
					"label": "Gambar denah",
					"type": "image"
				},
