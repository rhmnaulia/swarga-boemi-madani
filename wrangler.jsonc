{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "swarga-boemi-madani",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Resource IDs from `wrangler d1 create` / `wrangler kv namespace create`. These point at the
	// developer's personal account (temporary, workers.dev); replace them at handover. See README "Deploy".
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "swarga-boemi-madani",
			"database_id": "0ac85267-a0c6-4295-851e-67024dcfe2cc",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "swarga-boemi-madani-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "69f0a57f682046da854fd587236e41fc",
		},
	],
	"images": {
		"binding": "IMAGES",
	},
	// No "worker_loaders" (LOADER): phase 1 uses no sandboxed/marketplace plugins.
	// Cron drives scheduled publishing and EmDash maintenance.
	"triggers": {
		"crons": ["* * * * *"],
	},
	// Custom domain goes here at M4, once decided and moved to the client's Cloudflare account:
	// "routes": [{ "pattern": "example.com", "custom_domain": true }],
}
